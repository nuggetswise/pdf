# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
ORDER_AGENT_DATA_DIR=
ORDER_AGENT_MAX_UPLOAD_BYTES=10485760
# --- Hosted (Vercel) only; see docs/hosting-vercel.md. Set these in the Vercel dashboard, not here. ---
# DATABASE_URL=            Postgres URL (Neon sets it for you). Without it the app uses a local SQLite file.
# ORDER_AGENT_INLINE_PROCESSING=1   process inside the request (automatic on Vercel)
# ORDER_AGENT_GEMINI_TIMEOUT=25     seconds per Gemini call (hosted default 25, local 45)
# ORDER_AGENT_GEMINI_ATTEMPTS=3     tries per model (hosted default 3, local 4)
# ORDER_AGENT_GEMINI_BUDGET_SECONDS=100   total Gemini time per document across primary and fallback (hosted default)
# CRON_SECRET=             enables POST /api/internal/sweep with "Authorization: Bearer <value>"
